//Read from a memory location, such as MIDI receive buffer
uint16_t convertFromMidiValue(const uint8_t* mididata) {
  uint8_t msb = *mididata;
  uint8_t lsb = *(mididata+1);

  return (msb & 0x007F) <<7 | (lsb & 0x007F);
